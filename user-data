#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  timezone: Africa/Casablanca

  keyboard:
    layout: us

  network:
    version: 2
    ethernets:
      all-ethernet:
        match:
          name: "en*"
        dhcp4: true
        optional: true

  refresh-installer:
    update: false

  apt:
    preserve_sources_list: false
    geoip: false
    fallback: offline-install
    mirror-selection:
      primary:
        - uri: http://archive.ubuntu.com/ubuntu
          arches: [amd64]

  storage:
    layout:
      name: direct

  identity:
    hostname: computer
    username: store
    realname: Store Counter
    password: "$6$GCJ8afvpK731cClT$B9vysXPEkK8m1BbsrmEgAj/Tm5UdrPjLerWEcWomp9u4xltIQfRZvE392E5AWODLb.CwMezrSY0DWTovvvyJM/"

  ssh:
    install-server: true
    allow-pw: true

  packages:
    - ubuntu-desktop
    - openssh-server
    - python3
    - python3-venv
    - python3-pip
    - curl
    - git
    - wget
    - ffmpeg
    - vlc
    - net-tools
    - htop
    - unzip
    - libgl1
    - libglib2.0-0
    - libminizip1

  late-commands:
    - curtin in-target -- systemctl enable ssh
    - curtin in-target -- systemctl disable unattended-upgrades || true
    - curtin in-target -- systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target || true
    - curtin in-target -- mkdir -p /etc/gdm3
    - |
      cat > /target/etc/gdm3/custom.conf <<'EOF'
      [daemon]
      AutomaticLoginEnable=True
      AutomaticLogin=store
      WaylandEnable=false

      [security]

      [xdmcp]

      [chooser]

      [debug]
      EOF
    - curtin in-target -- mkdir -p /home/store/store_counter_system
    - curtin in-target -- chown -R store:store /home/store/store_counter_system
    - |
      set -e
      curtin in-target -- rm -rf /tmp/scu
      curtin in-target -- git clone --depth 1 https://github.com/A-YMANE-CH/scu.git /tmp/scu
      cp -a /target/tmp/scu/store_counter_system/. /target/home/store/store_counter_system/
      chmod +x /target/home/store/store_counter_system/*.sh
      curtin in-target -- chown -R store:store /home/store/store_counter_system
    - |
      cat > /target/usr/local/sbin/store-counter-first-boot.sh <<'EOF'
      #!/usr/bin/env bash
      set -u
      LOG=/var/log/store-counter-first-boot.log
      exec > >(tee -a "$LOG") 2>&1
      echo "Store counter first boot setup started at $(date -Is)"

      if [ -f /var/lib/store-counter-first-boot.done ]; then
        echo "Setup already completed."
        exit 0
      fi

      apt-get update || true

      if ! command -v teamviewer >/dev/null 2>&1; then
        echo "Installing TeamViewer..."
        if command -v curl >/dev/null 2>&1; then
          curl -fsSL "https://download.teamviewer.com/download/linux/teamviewer_amd64.deb" -o /tmp/teamviewer_amd64.deb
        else
          wget -O /tmp/teamviewer_amd64.deb "https://download.teamviewer.com/download/linux/teamviewer_amd64.deb"
        fi
        apt-get install -y /tmp/teamviewer_amd64.deb || true
      fi
      systemctl enable --now teamviewerd || true

      cd /home/store/store_counter_system
      chmod +x *.sh
      chown -R store:store /home/store/store_counter_system

      runuser -l store -c 'cd /home/store/store_counter_system && ./SETUP_FIRST_RUN.sh'
      runuser -l store -c 'cd /home/store/store_counter_system && ./DOWNLOAD_YOLOX_TINY_OPENVINO.sh'

      touch /var/lib/store-counter-first-boot.done
      systemctl disable store-counter-first-boot.service || true
      echo "Store counter first boot setup finished at $(date -Is)"
      EOF
    - curtin in-target -- chmod +x /usr/local/sbin/store-counter-first-boot.sh
    - |
      cat > /target/etc/systemd/system/store-counter-first-boot.service <<'EOF'
      [Unit]
      Description=Store counter first boot setup
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/store-counter-first-boot.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
      EOF
    - curtin in-target -- systemctl enable store-counter-first-boot.service

  shutdown: reboot
